# Copy to .env and adjust. Used by docker-compose.yml.

# Host port the app is published on.
PORT=3000

# Hosted database (PostgreSQL, e.g. the Supabase "Session pooler" string). Leave empty to use the SQLite file in the
# Docker volume. When set, every review, flag and moderator action is stored there and survives restarts.
DATABASE_URL=

# Moderators: comma-separated "label=identity" pairs (public key, P2PKH address or xpub).
ADMIN_IDENTITIES=

# Set to 0 to skip loading sample templates into an empty database.
SEED_ON_EMPTY=1

# Frontend build-time settings (baked into the bundle). Leave VITE_API_URL empty for same-origin.
VITE_API_URL=
VITE_SLIDES_URL=
VITE_REPO_URL=https://github.com/XOGrid-Cash/Blaze2026_XOGrid
VITE_EMBER_ADDRESS=
