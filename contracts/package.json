{
  "name": "xogrid-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BCH contracts converted into XO templates, one folder per contract system.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compile": "tsx shared/compile.ts",
    "template:json": "tsx shared/write-template-json.ts",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@bitauth/libauth": "3.1.0-next.8",
    "@xo-cash/engine": "0.1.1-next.18029697917",
    "@xo-cash/state": "0.0.5",
    "@xo-cash/templates": "0.0.12",
    "@xo-cash/utils": "0.0.11",
    "cashc": "0.14.0",
    "cashscript": "0.14.0"
  },
  "overrides": {
    "canvas": "npm:empty-npm-package@1.0.0"
  },
  "allowScripts": {
    "sqlite3@5.1.7": true
  }
}
