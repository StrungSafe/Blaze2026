# Used instead of the repo's .dockerignore when building templates/Dockerfile (context: repo root).
# Allow-list: only what the template tools page needs.
*
!frontend/src/assets/images/xogridlogo.png
!templates/package.json
!templates/package-lock.json
!templates/tsconfig.json
!templates/*/template.json
!templates/web/**

# Never send these, even inside allowed folders.
**/node_modules
**/dist
templates/.xo-demo
