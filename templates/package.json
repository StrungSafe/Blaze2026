{
  "name": "xogrid-templates",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BCH contracts converted into XO templates, one folder per contract system.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compile": "tsx shared/compile.ts",
    "template:json": "tsx shared/write-template-json.ts",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "web": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@bitauth/libauth": "3.1.0-next.8",
    "@electrum-cash/network": "4.4.8",
    "@xo-cash/engine": "0.1.1-next.18029697917",
    "@xo-cash/state": "0.0.5",
    "@xo-cash/templates": "0.0.12",
    "@xo-cash/utils": "0.0.11",
    "cashc": "0.14.0",
    "cashc-0.10": "npm:cashc@0.10.0-next.4",
    "cashc-0.9": "npm:cashc@0.9.3",
    "cashscript": "0.14.0"
  },
  "overrides": {
    "canvas": "npm:empty-npm-package@1.0.0",
    "cashc-0.9": {
      "@bitauth/libauth": "3.1.0-next.8"
    },
    "cashc-0.10": {
      "@bitauth/libauth": "3.1.0-next.8"
    }
  },
  "allowScripts": {
    "sqlite3@5.1.7": true
  }
}
